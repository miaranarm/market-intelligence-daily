+        head = f"Panorama de {len(ctx.get('rows', []))} actifs : régime {stance.lower()}."
+    if ctx.get("kind") == "weekly":
+        head = "Semaine écoulée. " + head
+    probs = scenario.get("probabilities") or {}
+    dek = stance + "."
