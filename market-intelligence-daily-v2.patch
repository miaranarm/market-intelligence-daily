+def _daily_sigma_pct(annualized_vol_pct: Any) -> float | None:
+    """Convertit une volatilité annualisée en écart-type quotidien (en %)."""
+    try:
+        vol = float(annualized_vol_pct)
+    except (TypeError, ValueError):
+        return None
+    if not math.isfinite(vol) or vol <= 0:
+        return None
+    return vol / math.sqrt(252)
+
+
+def neutral_band_pct(daily_sigma_pct: float | None, horizon: int = 1) -> float:
+    """Demi-largeur de la zone « neutre/central », liée à la volatilité quand elle est connue.
+
+    Sans volatilité enregistrée (anciennes prévisions), on garde l'ancienne bande de ±0,1 %.
+    """
+    if not daily_sigma_pct:
+        return 0.1
+    return max(0.1, CENTRAL_BAND_SIGMA * float(daily_sigma_pct) * math.sqrt(max(1, horizon)))
+
+
+def _direction_from_pct(pct: float, band: float) -> str:
+    return "hausse" if pct > band else ("baisse" if pct < -band else "neutre")
+
